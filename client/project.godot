; Project 002: Flow State kung fu sparring.
config_version=5

[application]
config/name="Project 002 - Flow State"
run/main_scene="res://scenes/kung_fu_dojo.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.06, 1)
